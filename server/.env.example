PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Local development database (docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hr_system?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/hr_system?schema=public

# Supabase alternative: pooled connection for runtime queries (PgBouncer, port 6543) ...
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# ... and a direct connection for Prisma migrations (port 5432)
# DIRECT_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# npm run setup replaces these with random values when it creates server/.env
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
