generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ROLE_HEAD_HR
  ROLE_CAMPUS_HR
  ROLE_EMPLOYEE
}

enum AdminScopeType {
  GLOBAL
  SCHOOL
  DEPARTMENT
}

enum EmployeeType {
  TEACHING
  NON_TEACHING
}

enum SchoolType {
  TEACHING
  NON_TEACHING
}

enum RequestType {
  LEAVE
  EXPENSE
  FUND
  OVERTIME
  UNDERTIME
  WFH
  TIME_ADJUSTMENT
  SHIFT_ASSIGNMENT
  SWAP_REQUEST
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeachingAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NonTeachingAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum PerformanceRubricType {
  TEACHING
  NON_TEACHING
}

model Campus {
  campusId                  String                  @id
  name                      String                  @unique
  code                      String?                 @unique
  address                   String?
  contact                   String?
  email                     String?
  status                    String                  @default("Active")
  picture                   String?
  schools                   School[]
  users                     User[]                  @relation("UserCampus")
  requests                  RequestRecord[]
  shifts                    Shift[]
  memos                     Memo[]
  nonTeachingAttendanceRows NonTeachingAttendance[]
  performanceEvaluations    PerformanceEvaluation[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
}

model School {
  schoolId            String               @id
  name                String
  type                SchoolType           @default(TEACHING)
  campusId            String
  campus              Campus               @relation(fields: [campusId], references: [campusId], onDelete: Cascade)
  departments         Department[]
  memos               Memo[]
  subjects            Subject[]
  teachingAssignments TeachingAssignment[]
  classSessions       ClassSession[]
  location            String?
  contact             String?
  email               String?
  status              String               @default("Active")
  picture             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([campusId, name])
  @@index([campusId])
  @@index([type])
}

model Department {
  departmentId              String                  @id
  name                      String
  schoolId                  String
  school                    School                  @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  users                     User[]
  requests                  RequestRecord[]
  shifts                    Shift[]
  memos                     Memo[]
  subjects                  Subject[]
  teachingAssignments       TeachingAssignment[]
  classSessions             ClassSession[]
  nonTeachingAttendanceRows NonTeachingAttendance[]
  performanceEvaluations    PerformanceEvaluation[]
  location                  String?
  contact                   String?
  email                     String?
  status                    String                  @default("Active")
  picture                   String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([schoolId])
  @@unique([schoolId, name])
}

model User {
  userId                      String                  @id @default(cuid())
  email                       String                  @unique
  passwordHash                String
  isActive                    Boolean                 @default(true)
  firstName                   String
  lastName                    String
  role                        Role
  employeeType                EmployeeType            @default(NON_TEACHING)
  department                  String?
  schoolBranch                String?
  position                    String?
  profileImage                String?
  joinDate                    DateTime                @default(now())
  idNumber                    String?
  sssId                       String?
  pagIbigId                   String?
  tinNo                       String?
  philhealthNo                String?
  schoolId                    String?
  departmentId                String?
  school                      Campus?                 @relation("UserCampus", fields: [schoolId], references: [campusId], onDelete: SetNull)
  departmentModel             Department?             @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  adminScopeType              AdminScopeType?
  adminSchoolId               String?
  adminSchoolName             String?
  adminDepartmentId           String?
  adminDepartmentName         String?
  requests                    RequestRecord[]         @relation("EmployeeRequests")
  reviewedRequests            RequestRecord[]         @relation("ReviewedRequests")
  createdShifts               Shift[]                 @relation("ShiftCreatedBy")
  createdMemos                Memo[]                  @relation("MemoCreatedBy")
  receivedMemos               Memo[]                  @relation("MemoRecipientEmployee")
  teachingAssignments         TeachingAssignment[]
  teachingAttendance          TeachingAttendance[]
  nonTeachingAttendanceRows   NonTeachingAttendance[]
  performanceEvaluations      PerformanceEvaluation[] @relation("EmployeePerformanceEvaluations")
  performanceEvaluationsGiven PerformanceEvaluation[] @relation("EvaluatorPerformanceEvaluations")
  refreshTokens               RefreshToken[]
  memoAcknowledgements        MemoAcknowledgement[]   @relation("EmployeeMemoAcknowledgements")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@index([role])
  @@index([adminScopeType])
  @@index([schoolId])
  @@index([departmentId])
  @@index([employeeType])
  @@index([schoolId, isActive])
  @@index([departmentId, isActive])
}

model RequestRecord {
  requestId    String        @id @default(cuid())
  type         RequestType
  status       RequestStatus @default(PENDING)
  title        String
  description  String?
  remarks      String?
  leaveStartDate DateTime?
  leaveEndDate   DateTime?
  employeeId   String
  reviewedById String?
  campusId     String
  departmentId String?
  employee     User          @relation("EmployeeRequests", fields: [employeeId], references: [userId], onDelete: Cascade)
  reviewedBy   User?         @relation("ReviewedRequests", fields: [reviewedById], references: [userId], onDelete: SetNull)
  campus       Campus        @relation(fields: [campusId], references: [campusId], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([employeeId])
  @@index([reviewedById])
  @@index([campusId])
  @@index([departmentId])
  @@index([status])
  @@index([campusId, status])
  @@index([departmentId, status])
  @@index([leaveStartDate, leaveEndDate])
  @@unique([type, employeeId, title])
}

model Shift {
  shiftId      String      @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  campusId     String
  departmentId String?
  createdById  String?
  campus       Campus      @relation(fields: [campusId], references: [campusId], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  createdBy    User?       @relation("ShiftCreatedBy", fields: [createdById], references: [userId], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([campusId])
  @@index([departmentId])
  @@unique([name, campusId, departmentId, startTime, endTime])
}

model Memo {
  memoId       String          @id @default(cuid())
  memoType     String          @default("Internal Memo")
  title        String
  content      String
  attachments  String[]        @default([])
  effectiveDate DateTime       @default(now())
  scopeType    AdminScopeType?
  campusId     String?
  schoolId     String?
  departmentId String?
  recipientEmployeeId String?
  createdById  String?
  campus       Campus?         @relation(fields: [campusId], references: [campusId], onDelete: Cascade)
  school       School?         @relation(fields: [schoolId], references: [schoolId], onDelete: SetNull)
  department   Department?     @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  recipientEmployee User?      @relation("MemoRecipientEmployee", fields: [recipientEmployeeId], references: [userId], onDelete: SetNull)
  createdBy    User?           @relation("MemoCreatedBy", fields: [createdById], references: [userId], onDelete: SetNull)
  publishedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  acknowledgements MemoAcknowledgement[] @relation("MemoAcknowledgements")

  @@index([campusId])
  @@index([schoolId])
  @@index([departmentId])
  @@index([recipientEmployeeId])
  @@unique([title, campusId, schoolId, departmentId, recipientEmployeeId])
}

model MemoAcknowledgement {
  id             String   @id @default(cuid())
  memoId         String
  employeeId     String
  acknowledgedAt DateTime @default(now())

  memo           Memo     @relation("MemoAcknowledgements", fields: [memoId], references: [memoId], onDelete: Cascade)
  employee       User     @relation("EmployeeMemoAcknowledgements", fields: [employeeId], references: [userId], onDelete: Cascade)

  @@unique([memoId, employeeId])
  @@index([memoId])
  @@index([employeeId])
}

model RefreshToken {
  refreshTokenId String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Subject {
  subjectId    String               @id @default(cuid())
  code         String
  name         String
  schoolId     String
  departmentId String?
  school       School               @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  department   Department?          @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  assignments  TeachingAssignment[]
  sessions     ClassSession[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([departmentId])
}

model TeachingAssignment {
  assignmentId String      @id @default(cuid())
  employeeId   String
  subjectId    String
  schoolId     String
  departmentId String?
  startsOn     DateTime
  endsOn       DateTime?
  employee     User        @relation(fields: [employeeId], references: [userId], onDelete: Cascade)
  subject      Subject     @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)
  school       School      @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([employeeId, subjectId, startsOn])
  @@index([employeeId])
  @@index([subjectId])
  @@index([schoolId])
  @@index([departmentId])
}

model ClassSession {
  classSessionId String               @id @default(cuid())
  subjectId      String
  schoolId       String
  departmentId   String?
  sessionDate    DateTime
  startsAt       DateTime
  endsAt         DateTime
  room           String?
  subject        Subject              @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)
  school         School               @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  attendance     TeachingAttendance[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([subjectId, sessionDate])
  @@index([schoolId, sessionDate])
  @@index([departmentId, sessionDate])
}

model TeachingAttendance {
  attendanceId   String                   @id @default(cuid())
  employeeId     String
  classSessionId String
  status         TeachingAttendanceStatus @default(PRESENT)
  remarks        String?
  minutesLate    Int?
  employee       User                     @relation(fields: [employeeId], references: [userId], onDelete: Cascade)
  classSession   ClassSession             @relation(fields: [classSessionId], references: [classSessionId], onDelete: Cascade)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([employeeId, classSessionId])
  @@index([employeeId])
  @@index([classSessionId])
  @@index([status])
}

model NonTeachingAttendance {
  attendanceId   String                      @id @default(cuid())
  employeeId     String
  schoolId       String
  departmentId   String?
  attendanceDate DateTime
  status         NonTeachingAttendanceStatus @default(PRESENT)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  remarks        String?
  minutesLate    Int?
  employee       User                        @relation(fields: [employeeId], references: [userId], onDelete: Cascade)
  school         Campus                      @relation(fields: [schoolId], references: [campusId], onDelete: Cascade)
  department     Department?                 @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([schoolId, attendanceDate])
  @@index([departmentId, attendanceDate])
  @@index([status])
}

model PerformanceEvaluation {
  evaluationId String                @id @default(cuid())
  employeeId   String
  schoolId     String
  departmentId String?
  evaluatorId  String?
  rubricType   PerformanceRubricType
  periodStart  DateTime
  periodEnd    DateTime
  criteria     Json
  overallScore Float
  notes        String?
  employee     User                  @relation("EmployeePerformanceEvaluations", fields: [employeeId], references: [userId], onDelete: Cascade)
  evaluator    User?                 @relation("EvaluatorPerformanceEvaluations", fields: [evaluatorId], references: [userId], onDelete: SetNull)
  school       Campus                @relation(fields: [schoolId], references: [campusId], onDelete: Cascade)
  department   Department?           @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([employeeId])
  @@index([schoolId, rubricType])
  @@index([departmentId, rubricType])
  @@index([periodStart, periodEnd])
}